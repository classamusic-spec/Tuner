{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TUNER: Resonance Breaker",
  "version": "0.1.0",
  "identifier": "com.classamusic.tuner",
  "build": {
    "beforeDevCommand": "pnpm --filter @tuner/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @tuner/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "TUNER: Resonance Breaker",
        "width": 1600,
        "height": 900,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#0b1030"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Game",
    "shortDescription": "Restore the world to its 432 Hz rhythm.",
    "longDescription": "A third-person 3D action-platformer. Play as the Tuner, wield the Auralith, defeat the Detuner Commanders and return the world to the 432 Hz World Chord."
  }
}
